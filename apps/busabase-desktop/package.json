    "@tauri-apps/plugin-updater": "^2.10.1",
    "busabase-core": "workspace:*",
    "kui": "workspace:*",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "wouter": "^3.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
