{
  "name": "@busabase/desktop",
  "private": true,
  "version": "0.96.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3064",
    "build": "next build",
    "prepare:tauri": "node scripts/prepare-tauri-build.mjs",
    "preview": "npx serve out",
    "typecheck": "next typegen && tsc --noEmit",
    "tauri": "node scripts/tauri.mjs",
    "tauri:dev:software": "node scripts/tauri-dev-software.mjs",
    "test": "vitest run",
    "test:styles": "node --test tests/css-pipeline.test.mjs",
    "test:linux-launcher": "node --test tests/linux-launcher.test.mjs",
    "test:startup": "node --test tests/startup.browser.test.mjs",
    "test:updater": "node --test tests/updater.browser.test.mjs",
    "test:electron": "node --test electron/test/*.test.*"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "busabase-core": "workspace:*",
    "kui": "workspace:*",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "wouter": "^3.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "^2.11.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "appStatus": {
    "port": 3064,
    "description": "Busabase private local-first desktop shell with an OSS sidecar",
    "status": "in development",
    "openCore": true,
    "features": {
      "desktop": true,
      "sidecar": true,
      "localKnowledgeBase": true,
      "cloudRelay": false
    }
  }
}
