{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_BUILD_DISABLE_NPM_CACHE": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
