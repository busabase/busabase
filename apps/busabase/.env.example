PG_DATABASE_URL="pglite://.data/busabase"

# Drive file preview provider: "builtin" (default) or "previewfile".
# "previewfile" only takes over the formats the built-in preview cannot render
# (Office, EPUB, PSD, archives); text, images, PDF and playable media are still
# rendered locally and never leave this instance. The generated preview link is
# unauthenticated for its 60-minute lifetime: anyone who obtains it can open
# that file without a Busabase permission check.
# Save PREVIEWFILE_API_KEY in Settings > File Preview; OSS intentionally does
# not read that key from process.env. Restart after changing the provider.
# BUSABASE_FILE_PREVIEW_PROVIDER="previewfile"
# PREVIEWFILE_BASE_URL="https://previewfile.dev"
# PREVIEWFILE_MAX_FILE_SIZE_MB="50" # 1-500
# Encrypt locally stored Vault secrets (recommended for PreviewFile API keys).
# BUSABASE_VAULT_ENCRYPTION_KEY="replace-with-a-random-secret"

# Exact comma-separated origins allowed to embed /dashboard/*/airapp/*.
# Production defaults to https://dev.buda.im and https://buda.im.
# Local development also allows Buda at http://localhost:3040.
# BUSABASE_AIRAPP_EMBED_ORIGINS="https://dev.buda.im,https://buda.im"

# Storage for folder-backed nodes such as SkillNode.
# Local development:
STORAGE_URL="local:.data/busabase-storage?base_url=/api/storage&upload_url=/api/storage/upload"

# MinIO / S3-compatible local development:
# STORAGE_URL="minio://minioadmin:minioadmin@127.0.0.1:9000/busabase?ssl=false&auto_create=true"

# Cloudflare R2:
# STORAGE_URL="r2://ACCESS_KEY_ID:SECRET_ACCESS_KEY@ACCOUNT_ID.r2.cloudflarestorage.com/busabase"

# AWS S3:
# STORAGE_URL="s3://ACCESS_KEY_ID:SECRET_ACCESS_KEY@s3.amazonaws.com/busabase?region=us-east-1"

# Server-side wait ceilings in milliseconds. 0 (the default) sends nothing, so a
# pooled endpoint cannot reject the handshake. They are sent only when set here, and a
# pooler that does not proxy them answers FATAL 08P01 "unsupported startup parameter"
# for every connection. Behind such a pooler leave them at 0 and set the ceilings on
# the role instead:
#   ALTER ROLE <user> SET statement_timeout = '120s';
# PG_DATABASE_STATEMENT_TIMEOUT_MS="120000"
# PG_DATABASE_LOCK_TIMEOUT_MS="30000"
# PG_DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS="120000"
