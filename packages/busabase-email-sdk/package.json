{
  "name": "busabase-email-sdk",
  "version": "0.1.1",
  "description": "SMTP and Amazon SES email, IMAP replies, and permission-aware Busabase email records for Node.js.",
  "license": "MIT",
  "homepage": "https://github.com/busabase/busabase/tree/main/packages/busabase-email-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/busabase/busabase.git",
    "directory": "packages/busabase-email-sdk"
  },
  "bugs": {
    "url": "https://github.com/busabase/busabase/issues"
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:err": "biome check . --diagnostic-level=error",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run lint:err && pnpm run build"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.699.0",
    "@opentelemetry/api": "^1.9.0",
    "busabase-sdk": "workspace:^",
    "html-to-text": "^9.0.5",
    "imapflow": "^2.9.0",
    "mailparser": "^3.12.2",
    "marked": "^16.4.2",
    "nodemailer": "^7.0.7",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.3.0",
    "@types/nodemailer": "^6.4.17",
    "@types/sanitize-html": "^2.16.1",
    "@types/smtp-server": "^3.5.12",
    "smtp-server": "^3.21.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
