{
  "name": "busabase-package",
  "description": "The `busabase-package@1` format: GitHub source, layout read/write, install planning, and the five-pass apply. Shared by busabase-cli (`install` / `export`) and busabase-core's server-side install domain. Node-only APIs are fine here \u2014 it is never browser-bundled.",
  "version": "0.40.0",
  "private": false,
  "license": "MIT",
  "homepage": "https://github.com/busabase/busabase/tree/main/packages/busabase-package",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/busabase/busabase.git",
    "directory": "packages/busabase-package"
  },
  "bugs": "https://github.com/busabase/busabase/issues",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "exports": {
      "./apply": {
        "types": "./dist/apply.d.ts",
        "default": "./dist/apply.js"
      },
      "./audit": {
        "types": "./dist/audit.d.ts",
        "default": "./dist/audit.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "./collect": {
        "types": "./dist/collect.d.ts",
        "default": "./dist/collect.js"
      },
      "./discover": {
        "types": "./dist/discover.d.ts",
        "default": "./dist/discover.js"
      },
      "./frontmatter": {
        "types": "./dist/frontmatter.d.ts",
        "default": "./dist/frontmatter.js"
      },
      "./github": {
        "types": "./dist/github.d.ts",
        "default": "./dist/github.js"
      },
      "./index-build": {
        "types": "./dist/index-build.d.ts",
        "default": "./dist/index-build.js"
      },
      "./layout-read": {
        "types": "./dist/layout-read.d.ts",
        "default": "./dist/layout-read.js"
      },
      "./layout-write": {
        "types": "./dist/layout-write.d.ts",
        "default": "./dist/layout-write.js"
      },
      "./plan": {
        "types": "./dist/plan.d.ts",
        "default": "./dist/plan.js"
      },
      "./template": {
        "types": "./dist/template.d.ts",
        "default": "./dist/template.js"
      },
      "./tree": {
        "types": "./dist/tree.d.ts",
        "default": "./dist/tree.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./apply": {
      "types": "./src/apply.ts",
      "default": "./src/apply.ts"
    },
    "./audit": {
      "types": "./src/audit.ts",
      "default": "./src/audit.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./collect": {
      "types": "./src/collect.ts",
      "default": "./src/collect.ts"
    },
    "./discover": {
      "types": "./src/discover.ts",
      "default": "./src/discover.ts"
    },
    "./frontmatter": {
      "types": "./src/frontmatter.ts",
      "default": "./src/frontmatter.ts"
    },
    "./github": {
      "types": "./src/github.ts",
      "default": "./src/github.ts"
    },
    "./index-build": {
      "types": "./src/index-build.ts",
      "default": "./src/index-build.ts"
    },
    "./layout-read": {
      "types": "./src/layout-read.ts",
      "default": "./src/layout-read.ts"
    },
    "./layout-write": {
      "types": "./src/layout-write.ts",
      "default": "./src/layout-write.ts"
    },
    "./plan": {
      "types": "./src/plan.ts",
      "default": "./src/plan.ts"
    },
    "./template": {
      "types": "./src/template.ts",
      "default": "./src/template.ts"
    },
    "./tree": {
      "types": "./src/tree.ts",
      "default": "./src/tree.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run lint:err && pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome format . --write && biome check .",
    "lint:err": "biome format . --write && biome check . --write --diagnostic-level=error"
  },
  "dependencies": {
    "@orpc/contract": "^1.14.6",
    "@zip.js/zip.js": "^2.8.20",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "busabase-contract": "workspace:*",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
