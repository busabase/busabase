{
  "name": "sandock-contract",
  "description": "Client-safe sandbox surface: oRPC contracts (base OSS + cloud superset), pure-zod DTO/VO schemas, and the oRPC client factories. Pure leaf — no @orpc/server, no db/logic/server deps. Consumed by sandock-core, apps/sandock-cloud, apps/sandock.",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandock-ai/sandock.git",
    "directory": "packages/sandock-contract"
  },
  "bugs": "https://github.com/sandock-ai/sandock/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract/sandbox": {
      "types": "./src/contract/sandbox.ts",
      "default": "./src/contract/sandbox.ts"
    },
    "./contract/cloud": {
      "types": "./src/contract/cloud.ts",
      "default": "./src/contract/cloud.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    },
    "./types/*": {
      "types": "./src/types/*",
      "default": "./src/types/*"
    },
    "./api-client": {
      "types": "./src/api-client/index.ts",
      "default": "./src/api-client/index.ts"
    }
  },
  "dependencies": {
    "@orpc/client": "^1.14.6",
    "@orpc/contract": "^1.14.6",
    "@orpc/openapi-client": "^1.14.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
}
